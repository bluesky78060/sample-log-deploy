{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "typeRoots": ["./src/types", "./node_modules/@types"],
        "types": ["node"],
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@types/*": ["src/types/*"]
        }
    },
    "include": ["src/**/*", "src/types/**/*.d.ts"],
    "exclude": ["node_modules", "dist", "out", "docs"]
}
