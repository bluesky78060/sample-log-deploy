{
  "name": "sample-log-test",
  "productName": "시료접수대장(테스트)",
  "version": "1.9.0",
  "description": "My Electron application description",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite src --port 3005",
    "dev:electron": "npm run build:electron && concurrently -k \"vite src --port 3005\" \"wait-on http://localhost:3005 && electron-forge start -- --dev\"",
    "dev:build": "vite build src",
    "preview": "vite preview src",
    "start": "npm run build:electron && concurrently -k \"vite src --port 3005\" \"wait-on http://localhost:3005 && electron-forge start\"",
    "start:dev": "DEV_MODE=1 electron-forge start",
    "package": "npm run build && npm run build:electron && electron-forge package",
    "make": "npm run build && npm run build:electron && electron-forge make",
    "build": "npm run build:css && npm run sync-version && npx vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "publish": "electron-forge publish",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "sync-version": "node -e \"const p=require('./package.json');const fs=require('fs');const f='src/shared/constants.ts';let c=fs.readFileSync(f,'utf8');c=c.replace(/APP_VERSION:\\s*string\\s*=\\s*'[^']*'/,\\\"APP_VERSION: string = '\\\"+p.version+\\\"'\\\");fs.writeFileSync(f,c);console.log('Version synced to '+p.version);\"",
    "build:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --watch",
    "sync": "npm run build",
    "release": "node scripts/release.js"
  },
  "keywords": [],
  "author": "leechanhee",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.3.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "firebase": "^12.7.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "39.2.6",
    "eslint": "^10.0.2",
    "http-server": "^14.1.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4",
    "xlsx": "^0.18.5"
  }
}
