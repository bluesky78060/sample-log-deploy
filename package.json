{
  "name": "sample-log",
  "productName": "시료접수대장",
  "version": "1.8.0",
  "description": "My Electron application description",
  "main": "src/index.js",
  "scripts": {
    "dev": "vite src --port 3001",
    "dev:electron": "concurrently -k \"vite src --port 3001\" \"wait-on http://localhost:3001 && electron-forge start -- --dev\"",
    "dev:build": "vite build src",
    "preview": "vite preview src",
    "start": "concurrently -k \"vite src --port 3001\" \"wait-on http://localhost:3001 && electron-forge start\"",
    "start:dev": "DEV_MODE=1 electron-forge start",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "build": "npm run build:css && npm run sync-version && npx vite build",
    "publish": "electron-forge publish",
    "lint": "echo \"No linting configured\"",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "sync-version": "node -e \"const p=require('./package.json');const fs=require('fs');const f='src/shared/constants.js';let c=fs.readFileSync(f,'utf8');c=c.replace(/APP_VERSION\\s*[:=]\\s*'[^']*'/,\\\"APP_VERSION = '\\\"+p.version+\\\"'\\\");fs.writeFileSync(f,c);console.log('Version synced to '+p.version);\"",
    "build:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --minify",
    "watch:css": "tailwindcss -i src/styles/input.css -o src/shared/tailwind-output.css --watch",
    "sync": "npm run build"
  },
  "keywords": [],
  "author": "leechanhee",
  "license": "MIT",
  "dependencies": {
    "dompurify": "^3.3.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.6.2",
    "firebase": "^12.7.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.0.2",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "electron": "39.2.6",
    "http-server": "^14.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.11",
    "wait-on": "^9.0.4",
    "xlsx": "^0.18.5"
  }
}
